---
import Layout from '@/layouts/Layout.astro';
import HeroKeyLogo from '@/assets/images/hero-key-logo.webp'
import HeroKeyBackground from '@/assets/images/hero-key-background.webp'
import LogoVI from '@/assets/images/logo-vi.svg'
import PlayButton from '@/assets/images/play-button.svg'
import LogoCutted from '@/assets/images/logo-cutted.svg'
import FullLogo from '@/assets/images/full-logo.webp'
import PS5 from '@/assets/images/ps5.svg'
import Xbox from '@/assets/images/xbox.svg'
---

<Layout>

	<!-- Hero -->
	<div id="logo-mask" class="fixed  mt-5 top-0 w-full h-screen">

	    <section>

	 		<picture 
				
				id="hero-key"  
	   			class="scale-127 block overflow-hidden fixed display-block top-0 left-0"
	   		>
				
				<img
					id="hero-key-logo"
					src={HeroKeyLogo.src}
					class="absolute w-full h-full object-cover"
				/>

				<img
					id="hero-key-backround"
					src={HeroKeyBackground.src}
					class="w-full h-full object-cover"
				/>

	 		</picture>

		</section>

	</div>


	<!-- bloque 2 -->
	<div
		id="release-screen"
		class="fixed mt-29 inset-0 opacity-0 flex flex-col items-center justify-center -translate-y-[8vh] bg-[#060507]"
	>

		<!-- Logo -->
		<img
			id="full-logo"
			src={FullLogo.src}
			class="w-[25vh] h-auto"
		/>

		<!-- Texto -->
		<div
			id="gta-text"
			class="mt-4 text-center uppercase bg-gradient-to-br from-[#ce0473] via-[#f3b685] to-[#a849a8] 
			bg-clip-text text-transparent 
			selective-text"
		>

			<p class="text-7xl font-bold">
				Disponible
			</p>

			<p class="text-7xl font-bold">
				EL 19 DE NOVIEMBRE
			</p>

			<p class="text-7xl font-bold">
				DE 2026
			</p>

		</div>

		<!-- Plataformas -->
		<div class="flex gap-6 mt-8 h-7 
			items-center justify-center">

			<img
				src={PS5.src}
				alt="PS5"
				class="h-7 w-22 object-contain invert brightness-0"
			/>

			<img
				src={Xbox.src}
				alt="Xbox"
				class="h-7 w-22 object-contain invert brightness-0"
			/>

		</div>

	</div>


	<div
		class="fixed flex flex-col items-center 
		justify-between h-screen p-15 px-18 w-full"
	>

		<!-- Header -->
		<header class="flex justify-between w-full">

			<LogoVI
		 		class="size-9.5 text-white hover:text-yellow-100 
				transition-colors duration-500 
				cursor-pointer"
			/>

		</header>


		<!-- Botón -->
		<button class="absolute inset-0 m-auto cursor-pointer inline-block">

			<PlayButton
				id="hero-play-button"
				class="text-white m-auto size-22 mt-3 rounded-full 
				hover:scale-105 	
				transition-transform"
			/>

		</button>


		<!-- footer flechita -->
		<footer
			id="hero-footer"
			class="absolute bottom-7 m-auto flex items-center gap-3"
		>
			<!-- logo V cortado -->
			<LogoCutted
				class="text-white center-top-0 w-26 h-auto drop-shadow-[0_0_2px_rgba(255,255,255,0.5),0_0_8px_#000]"
			/>

			<span
				class="absolute uppercase tracking-[3px] text-[12.4px] 
				whitespace-nowrap text-center size-5 
				font-medium text-shadow=
				[0_0_2px_rgba(255,255,255,0.5),0_0_8px_#000] 
				-translate-x-2/3"
			>
				VER EL TRÁILER
			</span>

		</footer>



</Layout>

<div class="h-200vh]"></div>

</Layout>
	<div class="h-[200vh]"></div>
</Layout> 

<style>
	#logo-mask {
		background: white;
		mask-image:url("../assets/logo-stack.svg");
		mask-position: center 20%;
		mask-repeat: no-repeat;
		mask-size: clamp(5000vh,3500%, 0vh)
	}
</style>


<script>
	import { safeDecode } from "astro:schema"
import { gsap } from "gsap"
	
	import { ScrollTrigger } from "gsap/ScrollTrigger"

	gsap.registerPlugin(ScrollTrigger)

	const tl= gsap.timeline({
		ease: "power2.out",
		scrollTrigger: {
			scrub: 1
		}
	})

	tl
	 .to("#hero-key",{ duration: 1, scale: 1})
	 .to("#hero-key-logo", { opacity: 0},"<") 
	 .to ("#hero-footer", { opacity: 0}, "<")
	 .to ("#hero-play-button", { opacity: 0}, "<")
	 .to(
        "#logo-mask",
        {
            maskSize: "clamp(20vh, 25%, 26vh)",
			duration: 0.9,
        },
        0.15
     )
     .to(
        "#hero-key",
        {
            opacity: 0,
            duration: 0.2,
        },
        0.3
     )
     .to("#release-screen", {
        opacity: 1,
        startAt: { 
            clipPath: "circle(0% at 50% 100%)",
            webkitClipPath: "circle(0% at 50% 100%)"
        }, 
        clipPath: "circle(150% at 50% 100%)",
        webkitClipPath: "circle(150% at 50% 100%)",
        duration: 1.5,
        ease: "power2.inOut"
     }, "0.4")
     .from("#full-logo", {
        scale: 0.9,
        opacity: 0,
        duration: 0.1
     }, "<")

</script>