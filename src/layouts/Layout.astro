---
import KeepScrolling from '@/assets/images/keep-scrolling.svg'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
	
		<meta name="generator" content={Astro.generator} />
		<title>Landing Page GTA VI</title>
	</head>
<body> 
  <KeepScrolling class=" uppercase fixed bottom-3 right-0 left-0 mx-auto text-pink-300 z-50 pointer-events-none drop-shadow-2xl animate-bounce-pulse"/>
  <slot />
</body>
</html>

<style is:global>
	
@import "tailwindcss";
	@theme{
		--font-sans: "GTA", system-ui, sans-serif;
		--font-narrow: "GTANarrow", system-ui, sans-serif;
		
		---animate-bounce-pulse: bounce 2s ease-in-out infinite;
	}

	@keyframes bounce-pulse {
		0%, 100% {
			transform: translateY(0);
			opacity: 1;
		}
		50% {
			transform: translateY(-20px);
			opacity: 0.5;
		}
	}


	html,
	body {
		background: #111;
		overflow-x: hidden;                                               
		overscroll-behavior: none;
		min-height: 100vh;
		background-color: black;
		color: white;
		margin: 0;
		width: 100%;
		 
                                      		
	}
	
	@font-face {
		font-family: "GTA";
		src: url("../assets/fonts/gta-regular.woff") format("woff");
		font-weight: 700;
   		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "GTA";
		src: url("../assets/fonts/gta-bold.woff") format("woff");
		font-weight: bold;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "GTA";
		src: url("../assets/fonts/gta-semibold.woff") format("woff");
		font-weight: 600;
		font-style: normal;
		font-display: swap;
	}
	
	@font-face {
		font-family: "GTANarrow";
		src: url("../assets/fonts/gta-narrow.woff") format("woff");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}
	

</style>
